# Reference for the API's environment variables (all optional).
PORT=4000
# JSON file used for storage; set it empty to keep data in memory only.
DATA_FILE=data/db.json
# Seed the demo account when the store is empty.
SEED_DEMO=true
# Comma-separated origins allowed to call the API cross-origin (not needed behind the /api proxy).
CORS_ORIGIN=
BCRYPT_ROUNDS=10
SESSION_TTL_HOURS=168
